{
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run check)",
      "Bash(npm run verify)",
      "Bash(npm install)",
      "Bash(npm ci)"
    ],
    "deny": [
      "Bash(npm run watch:*)",
      "Bash(git push --force:*)",
      "Edit(theme.css)",
      "Edit(publish.css)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-post-edit.mjs\""
          }
        ]
      }
    ]
  }
}
